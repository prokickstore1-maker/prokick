# PostgreSQL Database (Coolify / Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prokick_my

# Session & Security
NEXTAUTH_SECRET=prokick_super_secret_session_key_2026

# Garage object storage (S3-compatible; nilai IDCloudHost lama SUDAH DIGANTI)
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=prokick-store
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Telegram Admin Notification Bot
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Public URL & Currency
NEXT_PUBLIC_APP_URL=http://localhost:3000

